generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum ChatType {
  DIRECT
  GROUP
}

model User {
  id       String @id @default(uuid())
  username String @unique
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)
  gender   Gender

  settings UserSettings? @relation("UserToSettings")
}

model UserSettings {
  id                   String   @id @default(uuid())
  user                 User     @relation("UserToSettings", fields: [userId], references: [id], onDelete: Cascade)
  userId               String   @unique
  themeColor           String?
  timeZone             String?
  language             String?
  notificationsEnabled Boolean  @default(true)
  statusMessage        String?
  profileImage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
